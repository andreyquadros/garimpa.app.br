# Pepita Social · variáveis da API (copie para .env na raiz de garimpa/ ou configure no Dokploy)
NODE_ENV=production
PORT=8787
DATABASE_URL=postgres://garimpa:troque-esta-senha@garimpa-db:5432/garimpa
# Gere com: openssl rand -hex 32
SESSION_SECRET=
# OAuth client "Web application" em https://console.cloud.google.com/apis/credentials
# Origens JavaScript autorizadas: https://garimpa.app.br (e http://localhost:5173 em dev)
GOOGLE_CLIENT_ID=
# Em produção fica desligado; em desenvolvimento permite entrar só com um nome
ALLOW_DEV_LOGIN=false
PUBLIC_URL=https://garimpa.app.br
UPLOAD_DIR=/data/uploads
# A API serve o build do PWA quando este caminho existe (um contêiner só)
SERVE_WEB_DIR=/app/web/dist
TRUST_PROXY=true
MAX_UPLOAD_MB=8
# Tiles do mapa: OpenStreetMap por padrão; aponte para um servidor próprio do Pepita Social se hospedar tiles
TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILES_FALLBACK_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Cache (ADR-0006): senha do Redis do compose. Use só letras e números (gere com: openssl rand -hex 24),
# porque ela entra sem codificação em REDIS_URL=redis://:SENHA@garimpa-cache:6379/0 (montada pelo compose);
# com @ : / # ? % ou espaço a URL fica inválida e o cache falha em silêncio (a API segue sem cache).
# Se precisar de símbolos, codifique-os em porcentagem na URL.
# Fora do compose, REDIS_URL é opcional: sem ela a API roda sem cache (local: scripts/local-redis.sh,
# redis://127.0.0.1:63799). Bancos lógicos: /0 desenvolvimento, /1 e2e, /2 testes da API.
REDIS_PASSWORD=
