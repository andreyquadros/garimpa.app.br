{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/dist-demo",
      "!**/dev-dist",
      "!pnpm-lock.yaml",
      "!docs",
      "!web/public",
      "!.superpowers"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always" } },
  // O web/src/styles.css usa diretivas do Tailwind 4 (`@theme`, `@custom-variant`).
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        // O noUncheckedIndexedAccess do tsconfig obriga `rows[0]!` após `insert ... returning`,
        // onde a linha é garantida; por isso a asserção não nula fica liberada.
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      // Os testes leem respostas JSON arbitrárias, então `any` é aceitável ali.
      "includes": ["api/test/**"],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
    }
  ]
}
