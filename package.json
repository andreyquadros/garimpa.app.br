{
  "name": "garimpa",
  "private": true,
  "description": "Garimpa — achados colaborativos de produtos em Ariquemes (piloto)",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter garimpa-api db:migrate",
    "db:seed": "pnpm --filter garimpa-api db:seed",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "push:keys": "pnpm --filter garimpa-api exec tsx src/cli.ts push:keys",
    "cache:bump": "pnpm --filter garimpa-api exec tsx src/cli.ts cache:bump",
    "test:scripts": "node --test scripts/*.test.mjs",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 || exit 0; lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.1.15"
  }
}
